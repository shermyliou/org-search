{
  "name": "ngo-mission2-data",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run typecheck:data && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "pnpm run typecheck:data && tsc --noEmit",
    "lint": "biome lint --error-on-warnings src tests api vite.config.ts playwright.config.ts",
    "typecheck:data": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2023 --esModuleInterop --skipLibCheck --allowImportingTsExtensions scripts/organize-mission2.mts",
    "test": "playwright test",
    "check": "pnpm run lint && pnpm run build && pnpm run data:check && pnpm test",
    "data:organize": "node scripts/organize-mission2.mts",
    "data:check": "node scripts/organize-mission2.mts --check"
  },
  "dependencies": {
    "@anyblades/blades": "3.1.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@hugeicons/core-free-icons": "4.3.2",
    "exceljs": "4.4.0",
    "fuse.js": "7.4.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "8.0.10"
  }
}
